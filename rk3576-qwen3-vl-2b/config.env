# ============================================================================
#  Qwen3-VL-2B  ->  RK3576  转换套件：全局配置
# ----------------------------------------------------------------------------
#  所有 scripts/*.sh 都会 source 本文件。改这里，不要改脚本。
#  也可以用环境变量临时覆盖，例如：
#      WORKSPACE=/data/rkllm bash scripts/run_all.sh
# ============================================================================

# ---------------------------------------------------------------------------
# 目录
# ---------------------------------------------------------------------------
# 本套件所在目录（由 _common.sh 导出），REPO_ROOT 即 rknn-llm 仓库根目录
REPO_ROOT="${REPO_ROOT:-$(cd "${KIT_DIR}/.." && pwd)}"
MM_DIR="${MM_DIR:-${REPO_ROOT}/examples/multimodal_model_demo}"
RKLLM_RT_DIR="${RKLLM_RT_DIR:-${REPO_ROOT}/rkllm-runtime}"
RKLLM_TOOLKIT_PKGS="${RKLLM_TOOLKIT_PKGS:-${REPO_ROOT}/rkllm-toolkit/packages}"

# 工作区：模型、ONNX、RKNN、RKLLM 产物都落在这里
WORKSPACE="${WORKSPACE:-${HOME}/rkllm-workspace}"
OUTPUT_DIR="${OUTPUT_DIR:-${KIT_DIR}/output}"
MODEL_DIR="${MODEL_DIR:-${WORKSPACE}/Qwen3-VL-2B-Instruct}"

# ---------------------------------------------------------------------------
# 模型
# ---------------------------------------------------------------------------
MODEL_ID="${MODEL_ID:-Qwen/Qwen3-VL-2B-Instruct}"
# 国内可设为 https://hf-mirror.com ；留空走官方 huggingface.co
HF_ENDPOINT="${HF_ENDPOINT:-}"
PIP_INDEX="${PIP_INDEX:-https://mirrors.aliyun.com/pypi/simple}"
# CPU 版 torch 索引（避免拉 2.5GB 的 CUDA 依赖）
TORCH_CPU_INDEX="${TORCH_CPU_INDEX:-https://download.pytorch.org/whl/cpu}"

# ---------------------------------------------------------------------------
# 目标平台与量化 —— RK3576 的硬性限制见 README「硬性约束速查」
# ---------------------------------------------------------------------------
TARGET_PLATFORM="${TARGET_PLATFORM:-rk3576}"
# RK3576 的 NPU 核心只有 2 个，官方可选值 [1, 2]。填 3 会失败。
NUM_NPU_CORE="${NUM_NPU_CORE:-2}"
# RK3576 支持: w4a16 / w4a16_g32 / w4a16_g64 / w4a16_g128 / w8a8
QUANTIZED_DTYPE="${QUANTIZED_DTYPE:-w4a16}"
# normal 或 grq。grq 精度更好但必须用 CUDA GPU（见 README）
QUANTIZED_ALGORITHM="${QUANTIZED_ALGORITHM:-normal}"
OPTIMIZATION_LEVEL="${OPTIMIZATION_LEVEL:-1}"
DEVICE="${DEVICE:-cpu}"

# 上下文长度：RKLLM 1.3.1 官方上限 16384，且必须按 32 对齐。
# 32K(32768) 无法制作，详见 README。
MAX_CONTEXT="${MAX_CONTEXT:-16384}"
# 运行时的最大生成长度（写进板端脚本，不是转换参数）
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-2048}"

# ---------------------------------------------------------------------------
# 视觉编码器
# ---------------------------------------------------------------------------
IMG_HEIGHT="${IMG_HEIGHT:-448}"
IMG_WIDTH="${IMG_WIDTH:-448}"
IMG_BATCH="${IMG_BATCH:-1}"
# 板端 imgenc/demo 使用的 NPU 核心数
RKNN_CORE_NUM="${RKNN_CORE_NUM:-2}"

# ---------------------------------------------------------------------------
# 工具链环境（conda）
# ---------------------------------------------------------------------------
CONDA_HOME="${CONDA_HOME:-${HOME}/miniforge3}"
RKLLM_ENV="${RKLLM_ENV:-rkllm-toolkit}"
RKNN_ENV="${RKNN_ENV:-rknn-toolkit2}"

# LLM 侧依赖版本（rkllm-toolkit/packages/requirements.txt 的约定）
RKLLM_PY_VER="${RKLLM_PY_VER:-3.10}"
# wheel 文件名里用的是 cp310 这种 tag，不是 cp3.10
RKLLM_PY_TAG="${RKLLM_PY_TAG:-$(printf '%s' "${RKLLM_PY_VER}" | tr -d '.')}"
RKLLM_TRANSFORMERS="${RKLLM_TRANSFORMERS:-5.8.0}"
RKLLM_TORCH="${RKLLM_TORCH:-2.6.0}"

# 视觉侧依赖版本（Qwen3-VL 官方指定）
RKNN_PY_VER="${RKNN_PY_VER:-3.10}"
RKNN_TOOLKIT2_SPEC="${RKNN_TOOLKIT2_SPEC:-rknn-toolkit2>=2.3.2}"
RKNN_TRANSFORMERS="${RKNN_TRANSFORMERS:-4.57.0}"
RKNN_ONNX="${RKNN_ONNX:-1.18.0}"
RKNN_TORCH="${RKNN_TORCH:-2.6.0}"

# ---------------------------------------------------------------------------
# 交叉编译（板端 demo）
# ---------------------------------------------------------------------------
# Rockchip 官方工具链解压后的目录；不存在时会自动退回 apt 的 aarch64-linux-gnu-g++
GCC_COMPILER="${GCC_COMPILER:-${HOME}/opts/gcc-arm-10.2-2020.11-x86_64-aarch64-none-linux-gnu}"
# 板端目录（adb push 目标）
BOARD_HOME="${BOARD_HOME:-/home/linaro}"
BOARD_APP_DIR="${BOARD_APP_DIR:-${BOARD_HOME}/qwen3-vl-2b}"

# ---------------------------------------------------------------------------
# 行为开关
# ---------------------------------------------------------------------------
# 允许在非 Linux x86_64 主机上继续（默认 0 = 直接报错退出）
ALLOW_UNSUPPORTED_HOST="${ALLOW_UNSUPPORTED_HOST:-0}"
# 推荐给 w4a16 用的 20 张校准图数量校验下限
MIN_QUANT_SAMPLES="${MIN_QUANT_SAMPLES:-20}"
